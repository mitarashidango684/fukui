<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SaaS 分析ダッシュボード</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f4f5f7;color:#111}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}

  /* ダッシュボード外枠 */
  .dash{display:flex;min-height:620px;background:#fff;border:0.5px solid #e2e2e2;border-radius:12px;overflow:hidden}

  /* サイドバー */
  .sidebar{width:200px;flex-shrink:0;background:#f8f8f6;border-right:0.5px solid #e2e2e2;display:flex;flex-direction:column}
  .logo{padding:16px 18px;border-bottom:0.5px solid #e2e2e2;display:flex;align-items:center;gap:8px}
  .logo-mark{width:28px;height:28px;background:#1a56cc;border-radius:6px;display:flex;align-items:center;justify-content:center}
  .logo-mark i{color:#fff;font-size:15px}
  .logo-name{font-size:14px;font-weight:500;color:#111}
  .nav{padding:12px 8px;flex:1}
  .nav-section{font-size:10px;font-weight:500;color:#9a9a96;text-transform:uppercase;letter-spacing:.08em;padding:8px 10px 4px}
  .nav-item{display:flex;align-items:center;gap:9px;padding:7px 10px;border-radius:6px;cursor:pointer;font-size:13px;color:#555;margin-bottom:1px;transition:background .12s}
  .nav-item:hover{background:#fff}
  .nav-item.active{background:#1a56cc;color:#fff}
  .nav-item i{font-size:16px;color:#aaa}
  .nav-item.active i{color:#fff}
  .badge{margin-left:auto;font-size:11px;background:#e93d3d;color:#fff;padding:1px 6px;border-radius:10px;font-weight:500}
  .sidebar-bottom{padding:12px 8px;border-top:0.5px solid #e2e2e2}
  .avatar{width:32px;height:32px;border-radius:50%;background:#1a56cc;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:500;color:#fff}
  .user-row{display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;cursor:pointer}
  .user-row:hover{background:#fff}
  .user-name{font-size:12px;font-weight:500;color:#111}
  .user-role{font-size:11px;color:#aaa}

  /* メインエリア */
  .main{flex:1;display:flex;flex-direction:column;min-width:0}

  /* トップバー */
  .topbar{padding:12px 20px;border-bottom:0.5px solid #e2e2e2;display:flex;align-items:center;gap:12px}
  .search-box{flex:1;max-width:280px;display:flex;align-items:center;gap:8px;background:#f8f8f6;border:0.5px solid #e2e2e2;border-radius:8px;padding:6px 10px}
  .search-box input{border:none;background:none;font-size:13px;color:#111;outline:none;width:100%}
  .search-box input::placeholder{color:#aaa}
  .search-box i{font-size:15px;color:#aaa}
  .topbar-right{display:flex;align-items:center;gap:6px;margin-left:auto}
  .icon-btn{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;border:0.5px solid #e2e2e2;background:#fff;position:relative}
  .icon-btn:hover{background:#f8f8f6}
  .icon-btn i{font-size:16px;color:#555}
  .notif-dot{position:absolute;top:5px;right:5px;width:6px;height:6px;background:#e93d3d;border-radius:50%;border:1.5px solid #fff}
  .date-chip{font-size:12px;color:#555;background:#f8f8f6;border:0.5px solid #e2e2e2;padding:5px 10px;border-radius:8px;display:flex;align-items:center;gap:5px}

  /* コンテンツ */
  .content{padding:16px 20px;flex:1;overflow:auto;display:flex;flex-direction:column;gap:14px}
  .page-header{display:flex;align-items:baseline;justify-content:space-between}
  .page-title{font-size:18px;font-weight:500;color:#111}
  .page-sub{font-size:13px;color:#777;margin-top:2px}
  .tab-row{display:flex;gap:2px;background:#f8f8f6;border-radius:8px;padding:3px;align-self:flex-start}
  .tab{font-size:12px;padding:4px 12px;border-radius:6px;cursor:pointer;color:#777}
  .tab.active{background:#fff;color:#111;font-weight:500;box-shadow:0 0.5px 2px rgba(0,0,0,.06)}

  /* KPIカード */
  .kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
  .kpi{background:#f8f8f6;border-radius:8px;padding:12px 14px}
  .kpi-label{font-size:11px;font-weight:500;color:#9a9a96;text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;display:flex;align-items:center;gap:5px}
  .kpi-label i{font-size:13px}
  .kpi-value{font-size:22px;font-weight:500;color:#111;margin-bottom:4px}
  .kpi-delta{font-size:12px;display:flex;align-items:center;gap:3px}
  .up{color:#14804a}
  .down{color:#c0392b}

  /* チャートカード */
  .charts-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .chart-card{background:#fff;border:0.5px solid #e2e2e2;border-radius:12px;padding:14px 16px}
  .chart-title{font-size:13px;font-weight:500;color:#111;margin-bottom:3px}
  .chart-sub{font-size:11px;color:#aaa;margin-bottom:12px}
  .chart-legend{display:flex;gap:12px;margin-bottom:10px;flex-wrap:wrap}
  .legend-item{display:flex;align-items:center;gap:4px;font-size:11px;color:#777}
  .legend-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0}

  /* テーブル & ドーナツ */
  .bottom-row{display:grid;grid-template-columns:2fr 1fr;gap:10px}
  .table-card,.donut-card{background:#fff;border:0.5px solid #e2e2e2;border-radius:12px;padding:14px 16px}
  .tbl{width:100%;border-collapse:collapse}
  .tbl th{font-size:11px;font-weight:500;color:#aaa;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:0 8px 8px;border-bottom:0.5px solid #e2e2e2}
  .tbl td{font-size:12px;color:#111;padding:8px;border-bottom:0.5px solid #e2e2e2}
  .tbl tr:last-child td{border-bottom:none}
  .pill{display:inline-flex;align-items:center;font-size:11px;font-weight:500;padding:2px 8px;border-radius:10px}
  .pill-green{background:#eaf3de;color:#3b6d11}
  .pill-amber{background:#faeeda;color:#854f0b}
  .pill-red{background:#fcebeb;color:#a32d2d}
  .progress-bar-wrap{width:100%;background:#f0f0ee;border-radius:3px;height:5px;overflow:hidden}
  .progress-bar{height:100%;border-radius:3px}
  .donut-wrap{position:relative;width:100%;height:160px;margin:8px 0}
</style>
</head>
<body>

<h2 class="sr-only">SaaS 分析ダッシュボード — MRR、アクティブユーザー、チャーン率などの主要指標を表示</h2>

<div class="dash">

  <!-- sidebar -->
  <aside class="sidebar">
    <div class="logo">
      <div class="logo-mark"><i class="ti ti-chart-dots-3" aria-hidden="true"></i></div>
      <span class="logo-name">Metrics</span>
    </div>
    <nav class="nav">
      <div class="nav-section">メイン</div>
      <div class="nav-item active"><i class="ti ti-layout-dashboard" aria-hidden="true"></i>ダッシュボード</div>
      <div class="nav-item"><i class="ti ti-chart-bar" aria-hidden="true"></i>分析</div>
      <div class="nav-item"><i class="ti ti-users" aria-hidden="true"></i>ユーザー<span class="badge">24</span></div>
      <div class="nav-item"><i class="ti ti-arrows-exchange" aria-hidden="true"></i>コンバージョン</div>
      <div class="nav-section">設定</div>
      <div class="nav-item"><i class="ti ti-file-analytics" aria-hidden="true"></i>レポート</div>
      <div class="nav-item"><i class="ti ti-plug" aria-hidden="true"></i>インテグレーション</div>
      <div class="nav-item"><i class="ti ti-settings" aria-hidden="true"></i>設定</div>
    </nav>
    <div class="sidebar-bottom">
      <div class="user-row">
        <div class="avatar">福井</div>
        <div>
          <div class="user-name">福井</div>
          <div class="user-role">管理者</div>
        </div>
        <i class="ti ti-dots-vertical" aria-hidden="true" style="font-size:16px;color:#aaa;margin-left:auto"></i>
      </div>
    </div>
  </aside>

  <!-- main-->
  <div class="main">

    <!-- トップバー -->
    <div class="topbar">
      <div class="search-box">
        <i class="ti ti-search" aria-hidden="true"></i>
        <input type="text" placeholder="検索...">
      </div>
      <div class="date-chip"><i class="ti ti-calendar" aria-hidden="true"></i>2025年4月1日 — 4月30日</div>
      <div class="topbar-right">
        <div class="icon-btn" title="通知"><i class="ti ti-bell" aria-hidden="true"></i><span class="notif-dot"></span></div>
        <div class="icon-btn" title="フィルタ"><i class="ti ti-adjustments-horizontal" aria-hidden="true"></i></div>
        <div class="icon-btn" title="エクスポート"><i class="ti ti-download" aria-hidden="true"></i></div>
      </div>
    </div>

    <!-- コンテンツ -->
    <div class="content">

      <!-- ページヘッダー -->
      <div class="page-header">
        <div>
          <div class="page-title">概要</div>
          <div class="page-sub">先月比との比較</div>
        </div>
        <div class="tab-row">
          <div class="tab">日次</div>
          <div class="tab active">月次</div>
          <div class="tab">四半期</div>
          <div class="tab">年次</div>
        </div>
      </div>

      <!-- KPI カード -->
      <div class="kpi-grid">
        <div class="kpi">
          <div class="kpi-label"><i class="ti ti-currency-yen" aria-hidden="true"></i>MRR</div>
          <div class="kpi-value">¥4.8M</div>
          <div class="kpi-delta up"><i class="ti ti-trending-up" aria-hidden="true" style="font-size:13px"></i>+12.4%</div>
        </div>
        <div class="kpi">
          <div class="kpi-label"><i class="ti ti-users" aria-hidden="true"></i>アクティブユーザー</div>
          <div class="kpi-value">8,341</div>
          <div class="kpi-delta up"><i class="ti ti-trending-up" aria-hidden="true" style="font-size:13px"></i>+5.7%</div>
        </div>
        <div class="kpi">
          <div class="kpi-label"><i class="ti ti-user-plus" aria-hidden="true"></i>新規登録</div>
          <div class="kpi-value">623</div>
          <div class="kpi-delta up"><i class="ti ti-trending-up" aria-hidden="true" style="font-size:13px"></i>+18.2%</div>
        </div>
        <div class="kpi">
          <div class="kpi-label"><i class="ti ti-user-minus" aria-hidden="true"></i>チャーン率</div>
          <div class="kpi-value">2.1%</div>
          <div class="kpi-delta down"><i class="ti ti-trending-down" aria-hidden="true" style="font-size:13px"></i>-0.4pt</div>
        </div>
      </div>

      <!-- チャート（折れ線 & 棒グラフ） -->
      <div class="charts-row">

        <!-- 折れ線グラフ: MRR推移 -->
        <div class="chart-card">
          <div class="chart-title">MRR 推移</div>
          <div class="chart-sub">過去6ヶ月の月次推移</div>
          <div class="chart-legend">
            <span class="legend-item">
              <span class="legend-dot" style="background:#1a56cc"></span>MRR（実線 + 丸マーカー）
            </span>
            <span class="legend-item">
              <span class="legend-dot" style="background:#e6710a;clip-path:polygon(50% 0%,100% 100%,0% 100%)"></span>新規MRR（破線 + 三角マーカー）
            </span>
          </div>
          <div style="position:relative;width:100%;height:150px">
            <canvas id="lineChart"
              role="img"
              aria-label="MRR推移折れ線グラフ: 11月2.9M, 12月3.2M, 1月3.5M, 2月3.9M, 3月4.3M, 4月4.8M">
              MRR: 11月2.9M 12月3.2M 1月3.5M 2月3.9M 3月4.3M 4月4.8M
            </canvas>
          </div>
        </div>

        <!-- 棒グラフ: チャネル別新規ユーザー -->
        <div class="chart-card">
          <div class="chart-title">チャネル別新規ユーザー</div>
          <div class="chart-sub">流入元の内訳</div>
          <div class="chart-legend">
            <span class="legend-item"><span class="legend-dot" style="background:#1a56cc"></span>オーガニック</span>
            <span class="legend-item"><span class="legend-dot" style="background:#e6710a;clip-path:polygon(50% 0%,100% 100%,0% 100%)"></span>有料</span>
            <span class="legend-item"><span class="legend-dot" style="background:#14804a;border-radius:50%"></span>紹介</span>
            <span class="legend-item"><span class="legend-dot" style="background:#888780;transform:rotate(45deg)"></span>SNS</span>
          </div>
          <div style="position:relative;width:100%;height:150px">
            <canvas id="barChart"
              role="img"
              aria-label="チャネル別新規ユーザー棒グラフ: 11月〜4月の月別内訳">
              チャネル別データ
            </canvas>
          </div>
        </div>
      </div>

      <!-- 下段（テーブル + ドーナツ） -->
      <div class="bottom-row">

        <!-- テーブル -->
        <div class="table-card">
          <div class="chart-title">上位プラン別収益</div>
          <div class="chart-sub" style="margin-bottom:10px">プラン別の貢献度</div>
          <table class="tbl">
            <thead>
              <tr>
                <th>プラン</th>
                <th>ユーザー数</th>
                <th>MRR貢献</th>
                <th>成長</th>
                <th>ステータス</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Enterprise</strong></td>
                <td>142</td>
                <td>
                  <div style="display:flex;align-items:center;gap:6px">
                    <span>¥2.1M</span>
                    <div class="progress-bar-wrap" style="width:60px">
                      <div class="progress-bar" style="width:72%;background:#1a56cc"
                        role="progressbar" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100" aria-label="72%"></div>
                    </div>
                  </div>
                </td>
                <td class="up">+22%</td>
                <td><span class="pill pill-green">好調</span></td>
              </tr>
              <tr>
                <td><strong>Pro</strong></td>
                <td>891</td>
                <td>
                  <div style="display:flex;align-items:center;gap:6px">
                    <span>¥1.8M</span>
                    <div class="progress-bar-wrap" style="width:60px">
                      <div class="progress-bar" style="width:54%;background:#e6710a"
                        role="progressbar" aria-valuenow="54" aria-valuemin="0" aria-valuemax="100" aria-label="54%"></div>
                    </div>
                  </div>
                </td>
                <td class="up">+9%</td>
                <td><span class="pill pill-green">好調</span></td>
              </tr>
              <tr>
                <td><strong>Growth</strong></td>
                <td>2,103</td>
                <td>
                  <div style="display:flex;align-items:center;gap:6px">
                    <span>¥620K</span>
                    <div class="progress-bar-wrap" style="width:60px">
                      <div class="progress-bar" style="width:30%;background:#14804a"
                        role="progressbar" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100" aria-label="30%"></div>
                    </div>
                  </div>
                </td>
                <td class="up">+5%</td>
                <td><span class="pill pill-amber">普通</span></td>
              </tr>
              <tr>
                <td><strong>Starter</strong></td>
                <td>5,205</td>
                <td>
                  <div style="display:flex;align-items:center;gap:6px">
                    <span>¥280K</span>
                    <div class="progress-bar-wrap" style="width:60px">
                      <div class="progress-bar" style="width:14%;background:#888780"
                        role="progressbar" aria-valuenow="14" aria-valuemin="0" aria-valuemax="100" aria-label="14%"></div>
                    </div>
                  </div>
                </td>
                <td class="down">-2%</td>
                <td><span class="pill pill-red">要注意</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- ドーナツグラフ -->
        <div class="donut-card">
          <div class="chart-title">プラン構成比</div>
          <div class="chart-sub">ユーザー数ベース</div>
          <div class="donut-wrap">
            <canvas id="donutChart"
              role="img"
              aria-label="プラン構成比ドーナツグラフ: Enterprise 2%, Pro 11%, Growth 25%, Starter 62%">
              Enterprise 2%, Pro 11%, Growth 25%, Starter 62%
            </canvas>
          </div>
          <div style="display:flex;flex-direction:column;gap:5px;margin-top:4px">
            <div style="display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#777">
              <span style="display:flex;align-items:center;gap:5px"><span class="legend-dot" style="background:#1a56cc"></span>Enterprise</span>
              <span style="font-weight:500;color:#111">2%</span>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#777">
              <span style="display:flex;align-items:center;gap:5px"><span class="legend-dot" style="background:#e6710a;clip-path:polygon(50% 0%,100% 100%,0% 100%)"></span>Pro</span>
              <span style="font-weight:500;color:#111">11%</span>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#777">
              <span style="display:flex;align-items:center;gap:5px"><span class="legend-dot" style="background:#14804a;border-radius:50%"></span>Growth</span>
              <span style="font-weight:500;color:#111">25%</span>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#777">
              <span style="display:flex;align-items:center;gap:5px"><span class="legend-dot" style="background:#888780;transform:rotate(45deg)"></span>Starter</span>
              <span style="font-weight:500;color:#111">62%</span>
            </div>
          </div>
        </div>

      </div><!-- /bottom-row -->
    </div><!-- /content -->
  </div><!-- /main -->
</div><!-- /dash -->

<!-- chart.jp  -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
  const months   = ['11月','12月','1月','2月','3月','4月'];
  const gridColor = 'rgba(0,0,0,0.06)';
  const tickColor = 'rgba(0,0,0,0.4)';

  /* 折れ線グラフ: MRR推移 */
  new Chart(document.getElementById('lineChart'), {
    type: 'line',
    data: {
      labels: months,
      datasets: [
        {
          label: 'MRR',
          data: [2.9, 3.2, 3.5, 3.9, 4.3, 4.8],
          borderColor: '#1a56cc',
          backgroundColor: 'rgba(26,86,204,0.08)',
          /* アクセシビリティ: 丸マーカー + 実線 */
          pointStyle: 'circle',
          pointRadius: 4,
          pointBorderWidth: 2,
          pointBorderColor: '#1a56cc',
          pointBackgroundColor: '#fff',
          tension: 0.35,
          fill: true,
          borderWidth: 2.5,
        },
        {
          label: '新規MRR',
          data: [0.4, 0.5, 0.6, 0.7, 0.8, 1.0],
          borderColor: '#e6710a',
          backgroundColor: 'rgba(230,113,10,0)',
          /* アクセシビリティ: 三角マーカー + 破線 */
          pointStyle: 'triangle',
          pointRadius: 5,
          pointBorderColor: '#e6710a',
          pointBackgroundColor: '#e6710a',
          tension: 0.35,
          fill: false,
          borderWidth: 2,
          borderDash: [4, 3],
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ¥' + ctx.parsed.y + 'M' } }
      },
      scales: {
        x: { grid: { color: gridColor }, ticks: { color: tickColor, font: { size: 11 } } },
        y: {
          grid: { color: gridColor },
          ticks: { color: tickColor, font: { size: 11 }, callback: v => '¥' + v + 'M' },
          border: { display: false },
          min: 0
        }
      }
    }
  });

  /*  積み上げ棒グラフ: チャネル別新規ユーザー  */
  new Chart(document.getElementById('barChart'), {
    type: 'bar',
    data: {
      labels: months,
      datasets: [
        { label: 'オーガニック', data: [120,135,148,162,175,190], backgroundColor: '#1a56cc', borderRadius: 3, stack: 's' },
        { label: '有料',         data: [80,90,95,100,110,125],   backgroundColor: '#e6710a', borderRadius: 3, stack: 's' },
        { label: '紹介',         data: [45,52,58,65,70,80],      backgroundColor: '#14804a', borderRadius: 3, stack: 's' },
        { label: 'SNS',          data: [30,35,38,42,48,55],      backgroundColor: '#888780', borderRadius: 3, stack: 's' }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { color: tickColor, font: { size: 11 } }, stacked: true },
        y: { grid: { color: gridColor }, ticks: { color: tickColor, font: { size: 11 } }, stacked: true, border: { display: false } }
      }
    }
  });

  /*  ドーナツグラフ: プラン構成比 */
  new Chart(document.getElementById('donutChart'), {
    type: 'doughnut',
    data: {
      labels: ['Enterprise','Pro','Growth','Starter'],
      datasets: [{
        data: [142, 891, 2103, 5205],
        backgroundColor: ['#1a56cc','#e6710a','#14804a','#888780'],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '70%',
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => {
              const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
